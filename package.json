{
  "name": "watchcrop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrate-on-production-build.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/require-dev-db.ts && drizzle-kit migrate",
    "db:push": "tsx scripts/require-dev-db.ts && drizzle-kit push",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "art:landing": "node --conditions=react-server --import tsx scripts/landing-art.mts art",
    "art:demo": "node --conditions=react-server --import tsx scripts/landing-art.mts demo"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.2",
    "@vercel/blob": "^2.9.0",
    "botid": "^1.5.13",
    "drizzle-orm": "^0.45.4",
    "fuse.js": "^7.0.0",
    "next": "^16.4.6",
    "postgres": "^3.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "puppeteer-core": "^25.17.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-import": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
