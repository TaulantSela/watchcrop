# --- Database (Neon Postgres free tier works great) ---
# Get this from https://neon.tech -> your project -> Connection string (pooled).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Secrets ---
# Signs opaque crop-image tokens so future crops of today's puzzle can't be
# fetched without being earned. Generate: `openssl rand -hex 32`
GUESS_SECRET="change-me-to-a-long-random-string"

# Protects the /admin tooling. Generate: `openssl rand -hex 32`
ADMIN_TOKEN="change-me-too"

# --- Public config ---
NEXT_PUBLIC_SITE_NAME="WatchCrop"
# Shown on /privacy for data requests. Use an address you actually read.
NEXT_PUBLIC_CONTACT_EMAIL=""
# Flip to "true" to expose the live game at /play. Keep "false" during the
# de-risk phase so the public only sees the waitlist landing page.
NEXT_PUBLIC_GAME_LIVE="false"
